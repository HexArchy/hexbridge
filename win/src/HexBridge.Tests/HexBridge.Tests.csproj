<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- The same encoder the wizard draws its QR with, so the payload can be checked for
         size and shape without an Avalonia render surface. -->
    <PackageReference Include="Net.Codecrete.QrCodeGenerator" Version="3.2.1" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../HexBridge.Core/HexBridge.Core.csproj" />
    <ProjectReference Include="../HexBridge.Devices/HexBridge.Devices.csproj" />
    <ProjectReference Include="../HexBridge.Microphone/HexBridge.Microphone.csproj" />
    <ProjectReference Include="../HexBridge.Clipboard/HexBridge.Clipboard.csproj" />
    <ProjectReference Include="../HexBridge.Files/HexBridge.Files.csproj" />
  </ItemGroup>

</Project>