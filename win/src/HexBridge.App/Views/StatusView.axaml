<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HexBridge.App.ViewModels"
             xmlns:controls="using:HexBridge.App.Controls"
             x:Class="HexBridge.App.Views.StatusView"
             x:DataType="vm:StatusViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

      <Border Classes="status"
              Classes.ok="{Binding IsGood}"
              Classes.warn="{Binding IsWaiting}"
              Classes.bad="{Binding IsBad}">
        <StackPanel Spacing="6">
          <TextBlock Classes="display" Text="{Binding Headline}" />
          <TextBlock Classes="body" Text="{Binding Subline}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="УРОВЕНЬ" />
            <TextBlock Grid.Column="1" Classes="label" Text="{Binding PeakText}" />
          </Grid>
          <controls:LevelMeter Level="{Binding Level}" Peak="{Binding PeakMark}"
                               IsMuted="{Binding IsMuted}" />
        </StackPanel>
      </Border>

      <!--
        Three lines: who is talking, from where, and where the sound comes out.
        Пакетов в секунду, задержка, аптайм и глубина буфера moved to «Качество»
        — they are how well it works, and this page answers whether it works.
        «Сессия», «Слушаем» и «Релей» left altogether: the first is a protocol id
        nobody can act on, the other two are settings and are shown there.
      -->
      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="СОЕДИНЕНИЕ" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto" >
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Mac" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding SenderText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Адрес" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="mono" Text="{Binding PeerText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Звук идёт в" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding OutputText}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border CornerRadius="10" Padding="16,14"
              Background="{DynamicResource AppAccentSoft}"
              BorderBrush="{DynamicResource AppBorder}"
              BorderThickness="1"
              IsVisible="{Binding HasGameHint}">
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="{Binding GameHint, StringFormat='В играх и голосовых чатах выбирайте микрофон «{0}»'}" />
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
