<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HexBridge.App.ViewModels"
             xmlns:controls="using:HexBridge.App.Controls"
             x:Class="HexBridge.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

      <Border Classes="status"
              Classes.ok="{Binding IsGood}"
              Classes.warn="{Binding IsWaiting}"
              Classes.bad="{Binding IsBad}">
        <StackPanel Spacing="6">
          <TextBlock Classes="display" Text="{Binding Headline}" />
          <TextBlock Classes="body" Text="{Binding Subline}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="ДРАЙВЕР USBIP-WIN2" />
          <Grid ColumnDefinitions="150,*">
            <TextBlock Grid.Column="0" Classes="label" Text="usbip.exe" />
            <TextBlock Grid.Column="1" Classes="mono" Text="{Binding DriverText}" />
          </Grid>
          <Border CornerRadius="8" Padding="14,12"
                  Background="{DynamicResource WarnBg}"
                  BorderBrush="{DynamicResource WarnBorder}"
                  BorderThickness="1"
                  IsVisible="{Binding DriverMissing}">
            <StackPanel Spacing="6">
              <TextBlock Classes="section" Text="ЧТО СДЕЛАТЬ" />
              <TextBlock Classes="body" Text="{Binding DriverHint}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="ПРОБРОС" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Сервер USB/IP" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding ServerText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Клиент" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding ClientText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Занято номеров" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding SlotsText}" />
          </Grid>
          <TextBlock Classes="caption"
                     TextWrapping="Wrap"
                     IsVisible="{Binding !HasDevices}"
                     Text="Устройства выбираются на Mac — по умолчанию не пробрасывается ничего. Каждое выбранное появится здесь со своим busid: 1-1, 1-2, 1-3, 1-4." />
        </StackPanel>
      </Border>

      <!--
        One card per forwarded device, keyed by device number. A model the visualisation
        can decode gets its live outline — it is a self-check first and decoration second,
        because the user pulls a trigger and sees it arrive on this PC. Anything else gets
        the truth and nothing more: name, ids, rate, counters.

        The canvas carries no accessibility of its own, so the line underneath repeats in
        words what the picture says — that is the condition §8.4 attaches to using a canvas
        at all.
      -->
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ForwardedDeviceViewModel">
            <Border Classes="card" Margin="0,0,0,16">
              <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                  <StackPanel Grid.Column="0" Spacing="2">
                    <TextBlock Classes="section" Text="{Binding Title}" />
                    <TextBlock Classes="caption" Text="{Binding KindText}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Classes="mono" Text="{Binding BusIdText}" />
                </Grid>

                <controls:ControllerVisual Height="260"
                                           IsVisible="{Binding CanVisualise}"
                                           Source="{Binding Input}"
                                           Mood="{Binding Mood}" />
                <TextBlock Classes="caption" HorizontalAlignment="Center"
                           IsVisible="{Binding CanVisualise}"
                           Text="{Binding VisualCaption}" />

                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto"
                      IsVisible="{Binding ShowsSummary}">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="VID:PID" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="mono" Text="{Binding IdentityText}" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Состояние" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding StateText}" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="Порт vhci" />
                  <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding PortText}" />
                </Grid>

                <UniformGrid Columns="4">
                  <Border Classes="tile" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="Отчётов в секунду" />
                      <TextBlock Classes="metric" Text="{Binding RateText}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="tile" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="Батарея" />
                      <TextBlock Classes="metric" Text="{Binding BatteryText}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="tile" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="Принято отчётов" />
                      <TextBlock Classes="metric" Text="{Binding ReportsText}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="tile">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="Отправлено команд" />
                      <TextBlock Classes="metric" Text="{Binding OutputsText}" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto">
                  <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="Потеряно отчётов" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding LostText}" Margin="0,0,0,8" />
                  <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="Не забрано Windows" />
                  <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding DroppedText}" />
                </Grid>

                <TextBlock Classes="caption" TextWrapping="Wrap"
                           Text="Если автоподключение не сработало, эту команду можно выполнить вручную:" />
                <TextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding AttachCommand}" />
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
