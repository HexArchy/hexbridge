<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:HexBridge.App"
             xmlns:vm="using:HexBridge.App.ViewModels"
             xmlns:controls="using:HexBridge.App.Controls"
             x:Class="HexBridge.App.Views.DevicesView"
             x:DataType="vm:DevicesViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

      <Border Classes="status"
              Classes.ok="{Binding IsGood}"
              Classes.warn="{Binding IsWaiting}"
              Classes.bad="{Binding IsBad}">
        <StackPanel Spacing="6">
          <TextBlock Classes="display" Text="{Binding Headline}" />
          <TextBlock Classes="body" Text="{Binding Subline}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <!--
        The driver card appears only when the driver is missing — a row that
        always says «установлен» is a row nobody needs, and the path to
        usbip.exe is a setting and is shown in the settings. Same for the USB/IP
        server address and the client state: they are how the proxy is wired,
        not what it is doing, and each device card below says that for itself.
      -->
      <Border CornerRadius="8" Padding="14,12"
              Background="{DynamicResource WarnBg}"
              BorderBrush="{DynamicResource WarnBorder}"
              BorderThickness="1"
              IsVisible="{Binding DriverMissing}">
        <StackPanel Spacing="10">
          <TextBlock Classes="section" Text="{l:Tr Devices_Section_DriverNeeded}" />
          <TextBlock Classes="body" Text="{Binding DriverHint}" TextWrapping="Wrap" />

          <!-- The button picks x64 or ARM64 by the machine it is running on. The address is
               spelled out under it because a shell that refuses to open a browser must not
               turn a one-click install back into a dead end. -->
          <StackPanel Spacing="6" HorizontalAlignment="Left">
            <Button Classes="primary"
                    Content="{l:Tr Devices_Driver_Button_Download}"
                    Command="{Binding OpenDriverDownloadCommand}" />
            <SelectableTextBlock Classes="caption" Text="{Binding DriverUrl}" />
          </StackPanel>

          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{l:Tr Devices_Driver_Waiting}" />
        </StackPanel>
      </Border>

      <!-- The reward for installing a driver should not be a warning that silently
           disappears. Shown for a few seconds after it appears, then it steps aside. -->
      <Border CornerRadius="8" Padding="14,12"
              Background="{DynamicResource OkBg}"
              BorderBrush="{DynamicResource OkBorder}"
              BorderThickness="1"
              IsVisible="{Binding DriverJustInstalled}">
        <TextBlock Classes="body" Text="{l:Tr Devices_Driver_Installed}" />
      </Border>

      <TextBlock Classes="caption" Text="{Binding SlotsLine}" IsVisible="{Binding HasDevices}" />
      <TextBlock Classes="caption"
                 TextWrapping="Wrap"
                 IsVisible="{Binding !HasDevices}"
                 Text="{l:Tr Devices_Empty}" />

      <!--
        One card per forwarded device, keyed by device number. A model the visualisation
        can decode gets its live outline — it is a self-check first and decoration second,
        because the user pulls a trigger and sees it arrive on this PC. Anything else gets
        the truth and nothing more: name, ids, rate, counters.

        The canvas carries no accessibility of its own, so the line underneath repeats in
        words what the picture says — that is the condition §8.4 attaches to using a canvas
        at all.
      -->
      <ItemsControl ItemsSource="{Binding Devices}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ForwardedDeviceViewModel">
            <Border Classes="card" Margin="0,0,0,16">
              <StackPanel Spacing="12">
                <StackPanel Spacing="6">
                  <TextBlock Classes="section" Text="{Binding Title}" />
                  <TextBlock Classes="caption" Text="{Binding KindText}" />

                  <!-- The question this page kept failing to answer: is this a proper
                       DualSense with the triggers, or just a pad Windows happens to see.
                       A lit chip means it is doing that now, not that it could. -->
                  <ItemsControl ItemsSource="{Binding Capabilities}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:DeviceCapability">
                        <Border Classes="chip" Classes.ok="{Binding Live}" Margin="0,0,6,0">
                          <TextBlock Text="{Binding Text}" />
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{Binding CapabilityNote}"
                             IsVisible="{Binding CapabilityNote, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                </StackPanel>

                <controls:ControllerVisual Height="260"
                                           IsVisible="{Binding CanVisualise}"
                                           Source="{Binding Input}"
                                           Mood="{Binding Mood}" />
                <TextBlock Classes="caption" HorizontalAlignment="Center"
                           IsVisible="{Binding CanVisualise}"
                           Text="{Binding VisualCaption}" />

                <TextBlock Classes="body" Text="{Binding StateText}"
                           IsVisible="{Binding ShowsSummary}" />

                <!-- Two numbers on the surface: how fast the device is talking
                     and how much charge it has left. The rest are counters that
                     only matter once something is wrong, so they wait behind a
                     disclosure — as does the manual attach command, which is
                     offered only while Windows has not picked the device up. -->
                <UniformGrid Columns="2">
                  <Border Classes="tile" Margin="0,0,8,0">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="{l:Tr Devices_Metric_Rate}" />
                      <TextBlock Classes="metric" Text="{Binding RateText}" />
                    </StackPanel>
                  </Border>
                  <Border Classes="tile">
                    <StackPanel Spacing="2">
                      <TextBlock Classes="label" Text="{l:Tr Devices_Metric_Battery}" />
                      <TextBlock Classes="metric" Text="{Binding BatteryText}" />
                    </StackPanel>
                  </Border>
                </UniformGrid>

                <Expander Header="{l:Tr Devices_Expander_Details}">
                  <StackPanel Spacing="10" Margin="0,8,0,0">
                    <Grid ColumnDefinitions="180,*" RowDefinitions="Auto,Auto,Auto,Auto">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Tr Devices_Label_Received}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding ReportsText}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Tr Devices_Label_Outputs}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding OutputsText}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{l:Tr Devices_Label_Lost}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding LostText}" Margin="0,0,0,8" />
                      <TextBlock Grid.Row="3" Grid.Column="0" Classes="label" Text="{l:Tr Devices_Label_Dropped}" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Classes="body" Text="{Binding DroppedText}" />
                    </Grid>
                    <StackPanel Spacing="6" IsVisible="{Binding !IsImported}">
                      <TextBlock Classes="caption" TextWrapping="Wrap"
                                 Text="{l:Tr Devices_Attach_Hint}" />
                      <SelectableTextBlock Classes="mono" TextWrapping="Wrap" Text="{Binding AttachCommand}" />
                    </StackPanel>
                  </StackPanel>
                </Expander>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

    </StackPanel>
  </ScrollViewer>
</UserControl>
