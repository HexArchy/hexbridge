<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:HexBridge.App.ViewModels"
             xmlns:controls="using:HexBridge.App.Controls"
             x:Class="HexBridge.App.Views.QualityView"
             x:DataType="vm:QualityViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="820">

      <!-- The three numbers that used to head the Status page: they say how
           well the sound is arriving, which is this page's whole subject. -->
      <UniformGrid Columns="3">
        <Border Classes="tile" Margin="0,0,8,0">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Пакетов в секунду" />
            <TextBlock Classes="metric" Text="{Binding PacketsText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" Margin="0,0,8,0"
                ToolTip.Tip="Время до Mac и обратно. Оценка: нужны синхронные часы на обеих машинах.">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Задержка" />
            <TextBlock Classes="metric" Text="{Binding RttText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Аптайм" />
            <TextBlock Classes="metric" Text="{Binding UptimeText}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Grid.Column="0" Classes="section" Text="БУФЕР" />
            <TextBlock Grid.Column="1" Classes="label" Text="{Binding DepthText}" />
          </Grid>
          <ProgressBar Minimum="0" Maximum="1" Value="{Binding DepthFraction, Mode=OneWay}" Height="8" />
          <TextBlock Classes="caption"
                     Text="Больше буфер — меньше щелчков, но выше задержка." />
        </StackPanel>
      </Border>

      <UniformGrid Columns="3">
        <Border Classes="tile" Margin="0,0,8,8"
                ToolTip.Tip="Кадры, которых не было вовремя: Opus восстановил их приблизительно.">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Скрытые кадры" />
            <TextBlock Classes="metric" Text="{Binding ConcealedText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" Margin="0,0,8,8"
                ToolTip.Tip="Пакеты, пришедшие после того, как их момент уже отыграли.">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Поздние" />
            <TextBlock Classes="metric" Text="{Binding LateText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" Margin="0,0,0,8"
                ToolTip.Tip="Буфер опустел, и звук пришлось добить тишиной.">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Недоборы" />
            <TextBlock Classes="metric" Text="{Binding UnderrunsText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" Margin="0,0,8,0">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Декодировано" />
            <TextBlock Classes="metric" Text="{Binding DecodedText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile" Margin="0,0,8,0"
                ToolTip.Tip="Пакеты с чужим ключом, повторы и мусор из сети.">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Отброшено" />
            <TextBlock Classes="metric" Text="{Binding RejectedText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="Доля потерь" />
            <TextBlock Classes="metric" Text="{Binding LossText}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card">
        <StackPanel Spacing="18">
          <TextBlock Classes="section" Text="ПОСЛЕДНИЕ 60 СЕКУНД" />

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Пакетов в секунду" />
            <controls:Sparkline Values="{Binding PacketHistory}" Maximum="{Binding PacketHistoryMax}" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Уровень сигнала" />
            <controls:Sparkline Values="{Binding PeakHistory}" Maximum="1" />
          </StackPanel>

          <StackPanel Spacing="6">
            <TextBlock Classes="label" Text="Глубина буфера, кадров" />
            <controls:Sparkline Values="{Binding DepthHistory}" Maximum="{Binding MaxDepth}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
