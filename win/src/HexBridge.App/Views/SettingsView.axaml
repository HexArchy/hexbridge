<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:HexBridge.App"
             xmlns:vm="using:HexBridge.App.ViewModels"
             x:Class="HexBridge.App.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

  <Grid RowDefinitions="*,Auto">

    <ScrollViewer Grid.Row="0" Padding="24">
      <StackPanel Spacing="16" MaxWidth="820">

        <!--
          §9.5: after the first run the wizard never opens by itself again, but it stays
          one button away — and «Проверить связь» is the same six checks from §9.4,
          available at any time and not only during setup.
        -->
        <!--
          §7.4: «Проверить связь» lives here and only here — it is one check for
          all the features, so a copy of it on every page said the same thing
          three times over. Same wording as on the Mac.
        -->
        <!--
          First, because everything under it depends on the answer: which half of the pair
          this machine is. Read-only here and changed through the modal that explains the
          two choices, so there is one screen that says what they mean rather than two that
          each half say it.
        -->
        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="section" Text="{l:Tr Settings_Section_Role}" />
              <TextBlock Classes="heading" Text="{Binding RoleTitle}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding RoleSummary}" />
              <TextBlock Classes="caption" TextWrapping="Wrap" IsVisible="{Binding IsGiving}"
                         Text="{l:Tr Role_Sender_Caveat}" />
            </StackPanel>
            <Button Grid.Column="1" Content="{l:Tr Settings_Button_ChangeRole}" VerticalAlignment="Center"
                    Command="{Binding ChangeRoleCommand}" />
          </Grid>
        </Border>

        <Border Classes="card">
          <Grid ColumnDefinitions="*,Auto,Auto">
            <StackPanel Grid.Column="0" Spacing="4" VerticalAlignment="Center">
              <TextBlock Classes="heading" Text="{l:Tr Settings_Pair_Heading}" />
              <TextBlock Classes="caption" Text="{l:Tr Settings_Pair_Caption}" />
              <SelectableTextBlock Classes="mono dim" Text="{Binding FingerprintText}" />
            </StackPanel>
            <Button Grid.Column="1" Margin="0,0,8,0" Content="{l:Tr Settings_Button_Check}"
                    Command="{Binding CheckCommand}" VerticalAlignment="Center" />
            <Button Grid.Column="2" Classes="primary" Content="{l:Tr Settings_Button_Pair}"
                    Command="{Binding PairCommand}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Network}" />

            <StackPanel Spacing="6" IsVisible="{Binding IsTaking}">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Listen}" />
              <TextBox Text="{Binding Listen}" PlaceholderText="0.0.0.0:47702" />
              <TextBlock Classes="caption"
                         Text="{l:Tr Settings_Caption_Listen}" />
            </StackPanel>

            <StackPanel Spacing="6" IsVisible="{Binding IsGiving}">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Target}" />
              <TextBox Text="{Binding Target}" PlaceholderText="192.168.1.10:47702" />
              <TextBlock Classes="caption"
                         Text="{l:Tr Settings_Caption_Target}" />
            </StackPanel>

            <!-- §7.4: on the first level only what the user touches. The relay
                 and the raw key are for the case where pairing did not do the
                 job, and that is not most days. -->
            <Expander Header="{l:Tr Settings_Expander_KeyRelay}">
              <StackPanel Spacing="14" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_Psk}" />
                  <Grid ColumnDefinitions="*,Auto,Auto,Auto">
                    <TextBox Grid.Column="0" Text="{Binding Psk}"
                             PasswordChar="•"
                             RevealPassword="{Binding PskRevealed}"
                             FontFamily="Consolas, Menlo, DejaVu Sans Mono, monospace" />
                    <Button Grid.Column="1" Margin="8,0,0,0" Content="{l:Tr Settings_Button_Reveal}"
                            Command="{Binding TogglePskRevealCommand}" />
                    <Button Grid.Column="2" Margin="8,0,0,0" Content="{l:Tr Settings_Button_Copy}"
                            Command="{Binding CopyPskCommand}" />
                    <Button Grid.Column="3" Margin="8,0,0,0" Content="{l:Tr Settings_Button_Generate}"
                            Command="{Binding GeneratePskCommand}" />
                  </Grid>
                  <TextBlock Classes="caption"
                             Text="{l:Tr Settings_Caption_Psk}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_Relay}" />
                  <TextBox Text="{Binding Relay}" PlaceholderText="{l:Tr Settings_Placeholder_Relay}" />
                  <TextBlock Classes="caption"
                             Text="{l:Tr Settings_Caption_Relay}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_Room}" />
                  <SelectableTextBlock Classes="mono" Text="{Binding RoomId}" />
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:Tr Settings_Caption_Room}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsTaking}">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Devices}" />

            <CheckBox IsChecked="{Binding Gamepad}" Content="{l:Tr Settings_Check_Gamepad}" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:Tr Settings_Caption_Gamepad}" />

            <CheckBox IsChecked="{Binding UsbIpAutoAttach}"
                      IsEnabled="{Binding Gamepad}"
                      Content="{l:Tr Settings_Check_AutoAttach}" />

            <Expander Header="{l:Tr Settings_Expander_Driver}" IsEnabled="{Binding Gamepad}">
              <StackPanel Spacing="14" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_UsbIpListen}" />
                  <TextBox Text="{Binding UsbIpListen}" PlaceholderText="127.0.0.1:3240" />
                  <TextBlock Classes="caption"
                             Text="{l:Tr Settings_Caption_UsbIpListen}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_UsbIpPath}" />
                  <TextBox Text="{Binding UsbIpPath}"
                           PlaceholderText="C:\Program Files\USBip\usbip.exe" />
                  <TextBlock Classes="caption"
                             Text="{l:Tr Settings_Caption_UsbIpPath}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Clipboard}" />

            <CheckBox IsChecked="{Binding Clipboard}" Content="{l:Tr Settings_Check_Clipboard}" />

            <!-- The honest sentence, in the same words as on the «Буфер обмена»
                 page and on the Mac. A boxed three-sentence version of it next
                 to the checkbox was a warning nobody finishes reading. -->
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:Tr Clipboard_Privacy}" />
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Files}" />

            <CheckBox IsChecked="{Binding Files}" Content="{l:Tr Settings_Check_Files}" />

            <!-- Where files land and what happens to a name already taken. Both are
                 questions somebody asks once, before they switch this on. -->
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:Tr Settings_Caption_Files}" />

            <!-- The speed limit sits with files because that is what anybody looking for
                 it will have been watching, even though it holds the clipboard to the
                 same number: the two share one channel and one socket. -->
            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Speed}" />
              <ComboBox ItemsSource="{Binding Speeds}" SelectedItem="{Binding Speed}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:SpeedOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{l:Tr Settings_Caption_Speed}" />
            </StackPanel>
          </StackPanel>
        </Border>

        <!--
          The microphone this machine reads. The mirror image of «ВЫВОД ЗВУКА» below, and
          only one of the two is ever on screen: a machine either has a microphone to give
          away or somewhere to play one, never both at once.
        -->
        <Border Classes="card" IsVisible="{Binding IsGiving}">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Capture}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Source}" />
              <ComboBox ItemsSource="{Binding InputModes}" SelectedItem="{Binding Input}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:InputMode">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_Microphone}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{l:Tr Settings_Button_RefreshDevices}" Command="{Binding RefreshDevicesCommand}" />
              </Grid>
              <ComboBox ItemsSource="{Binding InputDevices}" SelectedItem="{Binding InputDevice}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeviceOption">
                    <TextBlock Text="{Binding Title}" Margin="0,2" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Text="{Binding InputNotice}"
                         IsVisible="{Binding InputNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_Gain}" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding InputGainText}" />
              </Grid>
              <Slider Minimum="0" Maximum="4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding InputGain}" />
              <TextBlock Classes="caption" Text="{l:Tr Settings_Caption_InputGain}" />
            </StackPanel>

            <CheckBox IsChecked="{Binding StartMuted}" Content="{l:Tr Settings_Check_StartMuted}" />

            <Expander Header="{l:Tr Settings_Expander_Codec}">
              <StackPanel Spacing="14" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                  <TextBlock Classes="label" Text="{l:Tr Settings_Label_Bitrate}" />
                  <ComboBox ItemsSource="{Binding Bitrates}" SelectedItem="{Binding Bitrate}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:BitrateOption">
                        <TextBlock Text="{Binding Title}" />
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>
                  <TextBlock Classes="caption" TextWrapping="Wrap"
                             Text="{l:Tr Settings_Caption_Bitrate}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card" IsVisible="{Binding IsTaking}">
          <StackPanel Spacing="14">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Output}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Mode}" />
              <ComboBox ItemsSource="{Binding OutputModes}" SelectedItem="{Binding Output}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:OutputMode">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_OutputDevice}" VerticalAlignment="Center" />
                <Button Grid.Column="1" Content="{l:Tr Settings_Button_RefreshDevices}" Command="{Binding RefreshDevicesCommand}" />
              </Grid>
              <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding Device}"
                        HorizontalAlignment="Stretch">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:DeviceOption">
                    <StackPanel Spacing="1" Margin="0,2">
                      <TextBlock Text="{Binding Title}" />
                      <TextBlock Classes="caption" Text="{Binding PairedText}"
                                 IsVisible="{Binding Paired, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </StackPanel>
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
              <TextBlock Classes="caption" Text="{Binding DeviceNotice}"
                         IsVisible="{Binding DeviceNotice, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_Gain}" />
                <TextBlock Grid.Column="1" Classes="label" Text="{Binding GainText}" />
              </Grid>
              <Slider Minimum="0" Maximum="4" TickFrequency="0.05" IsSnapToTickEnabled="True"
                      Value="{Binding Gain}" />
              <TextBlock Classes="caption" Text="{l:Tr Settings_Caption_Gain}" />
            </StackPanel>

            <!-- §7.4 «Дополнительно», collapsed: three latency knobs are the
                 definition of what a user does not touch on most days. -->
            <Expander Header="{l:Tr Settings_Expander_Latency}">
              <StackPanel Spacing="14" Margin="0,10,0,0">
                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_Jitter}" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding JitterText}" />
                  </Grid>
                  <Slider Minimum="20" Maximum="200" TickFrequency="20" IsSnapToTickEnabled="True"
                          Value="{Binding JitterMs}" />
                  <TextBlock Classes="caption" Text="{l:Tr Settings_Caption_Jitter}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_MaxJitter}" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding MaxJitterText}" />
                  </Grid>
                  <Slider Minimum="60" Maximum="600" TickFrequency="20" IsSnapToTickEnabled="True"
                          Value="{Binding MaxJitterMs}" />
                </StackPanel>

                <StackPanel Spacing="6">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Classes="label" Text="{l:Tr Settings_Label_Latency}" />
                    <TextBlock Grid.Column="1" Classes="label" Text="{Binding LatencyText}" />
                  </Grid>
                  <Slider Minimum="10" Maximum="200" TickFrequency="5" IsSnapToTickEnabled="True"
                          Value="{Binding LatencyMs}" />
                </StackPanel>
              </StackPanel>
            </Expander>
          </StackPanel>
        </Border>

        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_App}" />

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Language}" />
              <ComboBox ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" Width="220"
                        HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:LanguageOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="label" Text="{l:Tr Settings_Label_Theme}" />
              <ComboBox ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Width="220"
                        HorizontalAlignment="Left">
                <ComboBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ThemeOption">
                    <TextBlock Text="{Binding Title}" />
                  </DataTemplate>
                </ComboBox.ItemTemplate>
              </ComboBox>
            </StackPanel>

            <CheckBox Content="{l:Tr Settings_Check_StartOnLaunch}" IsChecked="{Binding StartOnLaunch}" />
            <CheckBox Content="{l:Tr Settings_Check_StartMinimised}" IsChecked="{Binding StartMinimised}" />
            <CheckBox Content="{l:Tr Settings_Check_Autostart}" IsChecked="{Binding Autostart}" />
            <TextBlock Text="{Binding AutostartError}"
                       IsVisible="{Binding AutostartError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                       Foreground="{DynamicResource BadFg}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{l:Tr Settings_Caption_Tray}" />
          </StackPanel>
        </Border>

        <!--
          Updates. One switch, one button, and no dialog that appears over a game: the
          check is silent, and everything after it needs a press. See docs/UPDATES.md.
        -->
        <Border Classes="card">
          <StackPanel Spacing="12">
            <TextBlock Classes="section" Text="{l:Tr Settings_Section_Updates}" />

            <CheckBox Content="{l:Tr Settings_Check_AutoUpdate}" IsChecked="{Binding AutoUpdate}" />
            <TextBlock Classes="caption" TextWrapping="Wrap" Text="{Binding Updates.Summary}" />

            <TextBlock TextWrapping="Wrap"
                       Text="{Binding Updates.Headline}"
                       IsVisible="{Binding Updates.HasMessage}" />
            <TextBlock Classes="caption" TextWrapping="Wrap"
                       Text="{Binding Updates.Detail}"
                       IsVisible="{Binding Updates.Detail, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{l:Tr Settings_Button_CheckNow}"
                      Command="{Binding Updates.CheckCommand}"
                      IsEnabled="{Binding !Updates.IsBusy}"
                      IsVisible="{Binding Updates.IsSupported}" />
              <Button Content="{l:Tr Settings_Button_Download}"
                      Command="{Binding Updates.DownloadCommand}"
                      IsVisible="{Binding Updates.CanDownload}" />
              <Button Content="{l:Tr Settings_Button_Restart}"
                      Command="{Binding Updates.ApplyCommand}"
                      IsVisible="{Binding Updates.CanApply}" />
            </StackPanel>
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="1"
            Background="{DynamicResource AppSurface}"
            BorderBrush="{DynamicResource AppBorder}"
            BorderThickness="0,1,0,0"
            Padding="24,12">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <!-- The bar speaks only when it has something to say: a standing
             notice that saving restarts the stream is a line the user reads
             once and then reads past for ever. -->
        <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="2">
          <TextBlock Classes="caption" Text="{l:Tr Settings_Dirty}"
                     IsVisible="{Binding IsDirty}" />
          <TextBlock Classes="body" Foreground="{DynamicResource BadFg}"
                     Text="{Binding ValidationError}"
                     IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Button Grid.Column="1" Content="{l:Tr Settings_Button_Revert}" Margin="0,0,8,0"
                Command="{Binding RevertCommand}" IsEnabled="{Binding IsDirty}" />
        <Button Grid.Column="2" Content="{l:Tr Settings_Button_Save}" Classes="primary"
                Command="{Binding SaveCommand}" />
      </Grid>
    </Border>

  </Grid>
</UserControl>
