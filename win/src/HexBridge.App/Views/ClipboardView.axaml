<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:l="using:HexBridge.App"
             xmlns:vm="using:HexBridge.App.ViewModels"
             x:Class="HexBridge.App.Views.ClipboardView"
             x:DataType="vm:ClipboardViewModel">

  <ScrollViewer Padding="24">
    <StackPanel Spacing="16" MaxWidth="820" HorizontalAlignment="Stretch">

      <Border Classes="status"
              Classes.ok="{Binding IsGood}"
              Classes.warn="{Binding IsWaiting}"
              Classes.bad="{Binding IsBad}">
        <StackPanel Spacing="6">
          <TextBlock Classes="display" Text="{Binding Headline}" />
          <TextBlock Classes="body" TextWrapping="Wrap" Text="{Binding Subline}" />
        </StackPanel>
      </Border>

      <!--
        The privacy line lives on the page, not only in the settings. Somebody who opens this
        tab a month later should not have to remember what they agreed to: the clipboard is
        where passwords live, and the honest sentence belongs where the feature is watched.
      -->
      <!-- The honest sentence, not a reassuring one, and one sentence of it:
           the clipboard is where passwords spend the seconds between a manager
           and a login form, and that is the whole of what somebody needs to
           know before switching this on. -->
      <Border CornerRadius="8" Padding="14,12"
              Background="{DynamicResource WarnBg}"
              BorderBrush="{DynamicResource WarnBorder}"
              BorderThickness="1"
              IsVisible="{Binding IsOn}">
        <TextBlock Classes="body" TextWrapping="Wrap"
                   Text="{l:Tr Clipboard_Privacy}" />
      </Border>

      <!-- The bar only. What is moving and which way is the headline above it. -->
      <ProgressBar Minimum="0" Maximum="1" Value="{Binding Progress}" Height="6"
                   IsVisible="{Binding IsTransferring}" />

      <!-- Counters of nothing, under a heading, are three rows of «—». While
           the feature is off the status card is the whole page. -->
      <UniformGrid Columns="2" IsVisible="{Binding IsOn}">
        <Border Classes="tile" Margin="0,0,8,0">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{l:Tr Clipboard_Metric_Sent}" />
            <TextBlock Classes="metric" Text="{Binding SentText}" />
          </StackPanel>
        </Border>
        <Border Classes="tile">
          <StackPanel Spacing="2">
            <TextBlock Classes="label" Text="{l:Tr Clipboard_Metric_Received}" />
            <TextBlock Classes="metric" Text="{Binding ReceivedText}" />
          </StackPanel>
        </Border>
      </UniformGrid>

      <Border Classes="card" IsVisible="{Binding IsOn}">
        <StackPanel Spacing="12">
          <TextBlock Classes="section" Text="{l:Tr Clipboard_Section_Last}" />
          <Grid ColumnDefinitions="150,*" RowDefinitions="Auto,Auto,Auto">
            <TextBlock Grid.Row="0" Grid.Column="0" Classes="label" Text="{l:Tr Clipboard_Label_What}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" Classes="body" Text="{Binding LastText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="0" Classes="label" Text="{l:Tr Clipboard_Label_Where}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" Classes="body" Text="{Binding LastDirectionText}" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Grid.Column="0" Classes="label" Text="{l:Tr Clipboard_Label_When}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Classes="body" Text="{Binding LastWhenText}" />
          </Grid>
          <TextBlock Classes="caption" TextWrapping="Wrap"
                     Text="{l:Tr Clipboard_Note_Recorded}" />
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
