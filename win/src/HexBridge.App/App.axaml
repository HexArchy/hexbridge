<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:semi="https://irihi.tech/semi"
             xmlns:vm="using:HexBridge.App.ViewModels"
             xmlns:views="using:HexBridge.App.Views"
             x:Class="HexBridge.App.App"
             RequestedThemeVariant="Default">

  <Application.Styles>
    <semi:SemiTheme Locale="ru-RU" />
    <StyleInclude Source="/Styles/Theme.axaml" />
  </Application.Styles>

  <!--
    How a page's view model finds its view. The shell hands a TabControl a view model and
    Avalonia picks the view from here, so neither the window nor a feature module ever
    names a control.
  -->
  <Application.DataTemplates>
    <DataTemplate DataType="vm:StatusViewModel"><views:StatusView /></DataTemplate>
    <DataTemplate DataType="vm:QualityViewModel"><views:QualityView /></DataTemplate>
    <DataTemplate DataType="vm:DevicesViewModel"><views:DevicesView /></DataTemplate>
    <DataTemplate DataType="vm:ClipboardViewModel"><views:ClipboardView /></DataTemplate>
    <DataTemplate DataType="vm:SettingsViewModel"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="vm:LogViewModel"><views:LogView /></DataTemplate>
  </Application.DataTemplates>

  <!--
    Colours, radii, spacing and durations all live in Styles/Tokens.axaml, which
    Styles/Theme.axaml merges. They are deliberately not repeated here: two dictionaries
    defining the same key would resolve differently depending on where the lookup started,
    and a DynamicResource that silently picks the wrong one leaves no trace anywhere.
  -->

</Application>
