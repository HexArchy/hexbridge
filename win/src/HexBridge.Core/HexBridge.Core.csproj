<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>HexBridge</RootNamespace>
    <!--
      English is the neutral table: it lives in the assembly itself rather than in an `en`
      satellite, so an English machine needs no satellite to load and a language with no
      table of its own falls back to English rather than to nothing.
    -->
    <NeutralLanguage>en</NeutralLanguage>
  </PropertyGroup>

  <ItemGroup>
    <!--
      The pairing encoders are internal because nothing outside this assembly should be
      building a payload by hand. The compatibility suite has to reach them anyway: it
      re-implements the Mac's parser and feeds it Windows' own base64url and ASCII
      transliteration, which is the only check that the two halves still agree.
    -->
    <InternalsVisibleTo Include="HexBridge.Tests" />
  </ItemGroup>

  <!--
    The string table. One .resx per language, English neutral, and the strongly typed
    accessor generated from the English one at build time — so a key that exists in the
    table exists as a property, and a key that does not is a compile error rather than an
    empty label somebody notices in a screenshot.
  -->
  <ItemGroup>
    <EmbeddedResource Update="Localization/Strings.resx">
      <Generator>MSBuild:Compile</Generator>
      <StronglyTypedFileName>$(IntermediateOutputPath)Strings.g.cs</StronglyTypedFileName>
      <StronglyTypedLanguage>CSharp</StronglyTypedLanguage>
      <StronglyTypedNamespace>HexBridge.Localization</StronglyTypedNamespace>
      <StronglyTypedClassName>Strings</StronglyTypedClassName>
      <PublicClass>true</PublicClass>
    </EmbeddedResource>
  </ItemGroup>

</Project>
