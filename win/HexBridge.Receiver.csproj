<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!--
    This project sits at the repo's win/ root so `cd win && dotnet publish` keeps working
    exactly as the README documents. The default glob would otherwise swallow src/**, which
    holds the library and the desktop app.
  -->
  <ItemGroup>
    <Compile Remove="src/**" />
    <None Remove="src/**" />
    <EmbeddedResource Remove="src/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="src/HexBridge.Core/HexBridge.Core.csproj" />
    <ProjectReference Include="src/HexBridge.Microphone/HexBridge.Microphone.csproj" />
    <ProjectReference Include="src/HexBridge.DualSense/HexBridge.DualSense.csproj" />
  </ItemGroup>

</Project>
